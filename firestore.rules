rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profili: rol (owner | staff) ve bağlı olduğu işletme (orgId).
    // Çalışan profilini yalnızca sunucu (ana hesap "Çalışan ekle" dediğinde) oluşturur.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == "owner"
                    && request.resource.data.orgId == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.orgId == resource.data.orgId
                    && request.resource.data.get("kind", null) == resource.data.get("kind", null)
                    && request.resource.data.get("courierOf", null) == resource.data.get("courierOf", null);
      allow delete: if false;
    }

    function signedIn() { return request.auth != null; }
    // Ana hesap: işletme kimliği kendi uid'si ve çalışan profili değil (çalışan kendi uid'siyle sahte işletme açamaz).
    // Profili olmayan eski hesaplar ana hesap sayılır.
    function isOwner(orgId) {
      return signedIn() && request.auth.uid == orgId
          && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "owner") != "staff");
    }
    // Çalışan: profilindeki orgId bu işletme ve rolü staff
    function isStaff(orgId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && p.role == "staff" && p.orgId == orgId;
    }
    function inOrg(orgId) { return isOwner(orgId) || isStaff(orgId); }
    // Velora Yemek kuryesi (profili yalnız sunucu açar: role "courier", courierOf = işletme). Yalnız okur; yazmalar /api/kurye
    function isCourier(orgId) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && p.get("role", "") == "courier" && p.get("courierOf", "") == orgId;
    }
    // Kişi türü: ana hesap "owner"; diğerleri users.kind (staff | family | athlete | student | parent | other; yoksa staff)
    function kindOfUser(u) {
      let ref = /databases/$(database)/documents/users/$(u);
      return !exists(ref) || get(ref).data.get("role", "owner") != "staff" ? "owner" : get(ref).data.get("kind", "staff");
    }
    function myKind() { return kindOfUser(request.auth.uid); }
    function athleteSide(k) { return k in ["athlete", "student", "parent"]; }
    // Birebir yazışma kimler arasında olabilir (lib/kinds.js canTalk ile aynı)
    // Sporcu (athlete) yalnız ana hesapla
    function talkOk(a, b) {
      return a == "owner" || b == "owner"
          || (a != "athlete" && b != "athlete"
              && ((a == "staff" && b == "staff") || (a == "family" && b == "family")
                  || (a == "staff" && athleteSide(b)) || (b == "staff" && athleteSide(a))));
    }
    function mine() { return request.auth.uid in resource.data.get("people", []); }
    function pay(d) { return d.get("payStatus", null); }
    // Çalışanın dokunamayacağı alanlar: kimlerin göreceği, sorumlular, ekleyen, ödeme durumu
    function lockedSame() {
      return request.resource.data.get("people", []) == resource.data.get("people", [])
          && request.resource.data.get("assignees", null) == resource.data.get("assignees", null)
          && request.resource.data.get("createdByUid", null) == resource.data.get("createdByUid", null)
          && pay(request.resource.data) == pay(resource.data)
          && request.resource.data.get("paidAt", null) == resource.data.get("paidAt", null)
          && request.resource.data.get("paidBy", null) == resource.data.get("paidBy", null);
    }
    // Bir alanda (map) yalnızca kendi anahtarı değişmiş mi: doneBy.{uid}, replies.{uid}, ack.{uid}
    function ownKey(f) {
      return request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    // Başkasının (ana hesabın) verdiği kayıtta çalışan: yalnızca kendisi için tamamladı, not ve iletildi/görüldü
    // Sporcuya hazırlanan fitness antrenmanı (plan, fit.for = sporcu): sporcu yalnız sonucu (fit.res) yazar
    function fitResOnly() {
      return resource.data.get("fit", null) != null
          && resource.data.fit.get("for", "") == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fit", "updatedAt", "updatedBy"])
          && request.resource.data.fit.diff(resource.data.fit).affectedKeys().hasOnly(["res"]);
    }
    function assignedOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["doneBy", "replies", "ack"])
          && ownKey("doneBy") && ownKey("replies") && ownKey("ack");
    }

    match /orgs/{orgId} {
      // Ana hesap: kendi işletmesindeki her şey (doğum günleri hariç: kişiye özel, aşağıda)
      match /{col}/{document=**} {
        allow read, write: if isOwner(orgId) && !(col in ["birthdays", "chats", "calls"]);
      }
      // Kurye: bugünün siparişleri ve yemek ayarı (kurye listesi), yalnız okuma
      match /yemekSiparisler/{id} {
        allow read: if isCourier(orgId);
      }
      match /yemek/ayar {
        allow read: if isCourier(orgId);
      }
      // Velora Sanal (velora-sanal deposu): çalışan ve aile bireyi market kataloğunu ve yalnız kendi market siparişlerini okur
      // (sorgu where uid == kendi uid). Sipariş ve iptal velora-sanal /api/siparis'ten (sunucu) yazılır.
      match /market/katalog {
        allow read: if isStaff(orgId) && myKind() in ["staff", "family"];
      }
      match /marketSiparisler/{id} {
        allow read: if isStaff(orgId) && myKind() in ["staff", "family"] && resource.data.get("uid", "") == request.auth.uid;
      }
      // Paket fotoğrafları (ana hesap yönetimde yükler; Sanal'da raftaki paket ve ürün bilgisi)
      match /marketFoto/{id} {
        allow read: if isStaff(orgId) && myKind() in ["staff", "family"];
      }
      // Doğum günleri kişiye özel: ana hesap yalnızca kendi eklediklerini okur/yazar
      match /birthdays/{id} {
        allow read, update, delete: if isOwner(orgId) && resource.data.get("createdByUid", null) == request.auth.uid;
        allow create: if isOwner(orgId) && request.resource.data.get("createdByUid", null) == request.auth.uid;
      }

      // Çalışan: yalnızca "people" listesinde kendisi olan kayıtlar
      match /{col}/{id} {
        allow read: if col in ["plans", "tasks", "notes", "receipts", "receiptImages", "birthdays", "lessons"] && isStaff(orgId) && mine();
        allow create: if col in ["plans", "tasks", "notes", "receipts", "receiptImages", "birthdays", "lessons"] && isStaff(orgId)
                      && (!(col in ["receipts", "receiptImages"]) || myKind() in ["staff", "family"])
                      && request.resource.data.get("people", []) == [request.auth.uid]
                      && request.resource.data.get("assignees", [request.auth.uid]) == [request.auth.uid]
                      && request.resource.data.get("createdByUid", null) == request.auth.uid
                      && pay(request.resource.data) in [null, "pending"];
        // Kendi eklediğini değiştirir; başkasının verdiğinde yalnızca tamamladı / not / görüldü
        allow update: if col in ["plans", "tasks", "notes", "receipts", "receiptImages", "birthdays", "lessons"] && isStaff(orgId) && mine() && lockedSame()
                      && (resource.data.get("createdByUid", null) == request.auth.uid || assignedOnly() || (col == "plans" && fitResOnly()));
        // Çalışan silemez: kendi eklediği kayda silme isteği (deleteReq) yazar, ana hesap onaylarsa ana hesap siler.
        // İstisna: doğum günleri ve ders programı kişiye özel; çalışan kendi eklediğini kendisi siler.
        allow delete: if col in ["birthdays", "lessons"] && isStaff(orgId) && resource.data.get("createdByUid", null) == request.auth.uid;
      }

      // Fitness hareketinin fotoğraf/videosu (src/features/fitness/fitMedia.js): ana hesap yazar (yukarıdaki genel kural),
      // çalışan ve sporcu kendi planındaki hareketin dosyasını okur
      match /fitMedia/{id}/{document=**} {
        allow read: if isStaff(orgId);
      }

      // ---- Sesli arama (src/lib/call.js) ----
      // Arama kaydını yalnız arayan ve aranan okur/yazar (ana hesap dahil başkası göremez). Arayan "çalıyor" olarak açar;
      // sonra yalnız durum, cevap, zaman ve yeniden bağlanma (offer, rev, arev) alanları değişir. Sporcu/öğrenci/veli şimdilik arayamaz ve aranamaz.
      match /calls/{callId} {
        function party(d) { return request.auth.uid == d.from || request.auth.uid == d.to; }
        function sameOrg(u) { return u == orgId || get(/databases/$(database)/documents/users/$(u)).data.get("orgId", "") == orgId; }
        function callOk(a, b) { return talkOk(a, b) && !athleteSide(a) && !athleteSide(b); }
        allow read: if inOrg(orgId) && party(resource.data);
        allow create: if inOrg(orgId)
                      && request.resource.data.keys().hasOnly(["from", "to", "kind", "status", "at", "offer"])
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.to is string && request.resource.data.to != request.auth.uid
                      && request.resource.data.kind == "audio" && request.resource.data.status == "ringing"
                      && request.resource.data.at == request.time
                      && sameOrg(request.resource.data.to)
                      && callOk(myKind(), kindOfUser(request.resource.data.to));
        allow update: if inOrg(orgId) && party(resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "answer", "answeredAt", "endedAt", "endedBy", "offer", "rev", "arev"])
                      && request.resource.data.status in ["ringing", "active", "declined", "missed", "ended", "failed"];
        allow delete: if false;
        // Ağ adresleri (bağlantı kurulurken birkaç tane): yalnız aramanın iki tarafı, herkes kendi adına yazar
        match /cands/{cand} {
          function callNow() { return get(/databases/$(database)/documents/orgs/$(orgId)/calls/$(callId)).data; }
          allow read: if inOrg(orgId) && party(callNow());
          allow create: if inOrg(orgId) && party(callNow())
                        && request.resource.data.keys().hasOnly(["by", "c"])
                        && request.resource.data.by == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // ---- Mesajlaşma ----
      // Rehber: işletmedeki herkesin adı ve son görülmesi (sohbet listesi için). Herkes okur, yalnızca kendi satırını yazar.
      match /directory/{did} {
        allow read: if inOrg(orgId);
        allow create, update: if inOrg(orgId) && request.auth.uid == did
                              && request.resource.data.keys().hasOnly(["name", "role", "lastSeen", "kind", "left"])
                              && request.resource.data.get("left", false) == false
                              && (!("kind" in request.resource.data) || request.resource.data.kind == myKind())
                              && request.resource.data.name is string && request.resource.data.name.size() <= 80
                              && request.resource.data.role == (isOwner(orgId) ? "owner" : "staff");
      }

      // Sohbetler: sabit gruplar "team" (çalışanlar), "family" (aile), "athletes" (sporcu, öğrenci, veli + çalışanlar) — ana hesap hepsinde;
      // "dm_<uid1>_<uid2>" (birebir, uid'ler sıralı; yalnızca türleri yazışabilen kişiler), grup (members listesi).
      // Konuşmayı yalnızca içindekiler okur ve yazar; ana hesap dahil başkası göremez.
      // seq: mesaj sayacı, read.{uid}: kişinin okuduğu son mesaj numarası, typing.{uid}: yazıyor, muted.{uid}: sessiz,
      // pinned: sabitlenen mesaj { id, text, by } (üyelerden herkes sabitler/kaldırır).
      match /chats/{cid} {
        function isTeam() { return cid in ["team", "family", "athletes"]; }
        function inFixed() {
          return isOwner(orgId)
              || (cid == "team" && myKind() == "staff")
              || (cid == "family" && myKind() == "family")
              || (cid == "athletes" && (myKind() == "staff" || athleteSide(myKind())));
        }
        // Sabit grupta türüne göre; diğerlerinde members listesine göre (sabit grup belgesinde members alanı olmaz)
        function memberOf(d) { return request.auth.uid in d.get("members", []) || (isTeam() && inFixed()); }
        // Yalnızca kendi anahtarı değişen alanlar ve sohbet özeti; ad ve üyeler yalnızca grubu kuran (ya da kendi çıkışı)
        function chatUpdateOk() {
          let ch = request.resource.data.diff(resource.data).affectedKeys();
          return ch.hasOnly(["last", "seq", "read", "recv", "typing", "muted", "archived", "name", "members", "updatedAt", "pinned"])
              && ownKey("read") && ownKey("recv") && ownKey("typing") && ownKey("muted") && ownKey("archived")
              && (!ch.hasAny(["name", "members"])
                  || (resource.data.get("type", "") == "group"
                      && (resource.data.get("createdBy", "") == request.auth.uid
                          || (!ch.hasAny(["name"]) && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])))));
        }
        allow read: if inOrg(orgId) && (resource == null || memberOf(resource.data));
        allow create: if inOrg(orgId) && (
          (isTeam() && request.resource.data.type == "team" && inFixed() && !("members" in request.resource.data))
          || (request.resource.data.type == "dm"
              && request.resource.data.members.size() == 2
              && request.auth.uid in request.resource.data.members
              && request.resource.data.members[0] < request.resource.data.members[1]
              && cid == "dm_" + request.resource.data.members[0] + "_" + request.resource.data.members[1]
              && talkOk(myKind(), kindOfUser(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0])))
          || (request.resource.data.type == "group" && !isTeam() && !cid.matches("dm_.*")
              && myKind() != "athlete"
              && request.auth.uid in request.resource.data.members
              && request.resource.data.members.size() <= 30
              && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60));
        allow update: if inOrg(orgId) && memberOf(resource.data) && chatUpdateOk();
        allow delete: if false;

        // Mesajlar: yalnızca sohbetin üyeleri. Silme = arşiv: ana hesap mesajı herkesten kaldırır (arch) ve geri alır,
        // diğerleri yalnız kendisinden gizler (hide.<uid>). Kalıcı silme yalnız ana hesap, yalnız arşivdeki mesaj.
        // Başkasının mesajına yalnızca kendi tepkisini koyar.
        match /messages/{mid} {
          function chatNow() { return get(/databases/$(database)/documents/orgs/$(orgId)/chats/$(cid)).data; }
          allow read: if inOrg(orgId) && memberOf(chatNow());
          allow create: if inOrg(orgId) && memberOf(getAfter(/databases/$(database)/documents/orgs/$(orgId)/chats/$(cid)).data)
                        && request.resource.data.keys().hasOnly(["by", "text", "at", "n", "replyTo", "file"])
                        && request.resource.data.by == request.auth.uid
                        && request.resource.data.at == request.time
                        && request.resource.data.text is string && request.resource.data.text.size() <= 4000
                        // Ek (fotoğraf, dosya, sesli mesaj) varsa yazı boş olabilir; dosya Storage'da kendi klasöründe
                        && (!("file" in request.resource.data)
                            || (request.resource.data.file is map
                                && request.resource.data.file.path is string
                                && request.resource.data.file.path.matches("orgs/" + orgId + "/chatFiles/" + cid + "/" + request.auth.uid + "/.*")))
                        && (request.resource.data.text.size() > 0 || "file" in request.resource.data);
          allow update: if inOrg(orgId) && memberOf(chatNow()) && (
            // Arşiv (herkesten): yalnız ana hesap; arşive kaldırır ya da geri alır
            (isOwner(orgId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["arch", "archBy", "archAt"])
              && (!("arch" in request.resource.data)
                || (request.resource.data.arch == true && request.resource.data.archBy == request.auth.uid)))
            // Kendinden gizle / geri al: herkes, yalnız kendi anahtarı
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hide"]) && ownKey("hide"))
            // Düzenleme: yalnızca kendi mesajı, gönderildikten sonraki 15 dakika içinde, arşivde değilse
            || (resource.data.by == request.auth.uid && resource.data.get("deleted", false) != true && resource.data.get("arch", false) != true
              && request.time < resource.data.at + duration.value(15, "m")
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
              && request.resource.data.editedAt == request.time
              && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]) && ownKey("reactions")));
          allow delete: if inOrg(orgId) && isOwner(orgId) && memberOf(chatNow()) && resource.data.get("arch", false) == true;
        }
      }

      // Öğrenme verisi: her kişinin kendi belgesi ({uid}_{YYYY-MM}). Çalışan yalnızca kendisininkini okur/yazar;
      // ana hesap (yukarıdaki kural) işletmedeki tüm belgeleri okur.
      match /learn/{id} {
        allow read: if isStaff(orgId) && id.matches(request.auth.uid + "_[0-9]{4}-[0-9]{2}");
        allow create, update: if isStaff(orgId) && id.matches(request.auth.uid + "_[0-9]{4}-[0-9]{2}")
                              && request.resource.data.uid == request.auth.uid;
      }
      // Asistan puan özeti (Ayarlar › Öğrenme raporu): her kişinin tek belgesi, yalnız kendisi okur/yazar
      match /learnSum/{id} {
        allow read, create, update: if isStaff(orgId) && id == request.auth.uid;
      }

      // Sporcu yoklama kopyası (kulüp verisinden yalnızca ad + yoklama): sporcunun kendisi ve bağlı velileri okur; ana hesap yazar
      match /athleteAtt/{mid} {
        allow read: if isStaff(orgId) && (request.auth.uid == mid || request.auth.uid in resource.data.get("parents", []));
      }

      // Alışveriş listesi: "family" listesini aile bireyleri, "team" listesini çalışanlar kullanır (ana hesap hepsini, yukarıdaki kural)
      match /shop/{id} {
        function shopOk(l) { return (l == "family" && myKind() == "family") || (l == "team" && myKind() == "staff"); }
        allow read, delete: if isStaff(orgId) && shopOk(resource.data.list);
        allow create: if isStaff(orgId) && shopOk(request.resource.data.list)
                      && request.resource.data.keys().hasOnly(["text", "list", "done", "by", "at", "doneBy", "doneAt"])
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 80;
        allow update: if isStaff(orgId) && shopOk(resource.data.list)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["done", "doneBy", "doneAt"]);
      }

      // Çalışan: kendi üye kaydında yalnızca "son görülme" zamanını günceller (ana hesap listede görür)
      match /members/{mid} {
        allow update: if isStaff(orgId) && request.auth.uid == mid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastSeen"])
                      && request.resource.data.lastSeen == request.time;
      }
    }
  }
}
