rules_version = '2';

// Firebase Storage kuralları (Firebase konsolu › Storage › Kurallar'a yapıştırılıp yayınlanır).
// fitMedia: fitness hareketlerinin fotoğraf ve videoları (src/features/fitness/fitMedia.js); ana hesap yükler/siler, aynı kulüp okur.
// raceFiles: yarışa eklenen evrak (src/features/athletes/raceStore.js); yalnız ana hesap.
// raceMedia: yarış multimedya sayfasında çekilen fotoğraf ve video (src/features/athletes/raceLiveStore.js); yalnız ana hesap, en çok 60 MB.
// receiptImages: fiş fotoğrafı (src/features/receipts/receiptPhoto.js); ana hesap hepsini, çalışan kendi eklediğini.
// postPhotos: Instagram gönderisinin fotoğrafı (src/features/posts/posts.js); yalnız ana hesap.
// invFiles, invoiceFiles, noticeFiles: envanter belgeleri, faturalar, yarış talimatı ve sonuç belgeleri (src/lib/firebase/fileStore.js); yalnız ana hesap.
// mailFiles: banka maillerinin Excel ekleri (src/features/mail/mailFiles.js); yalnız ana hesap.
// chatFiles: Mesajlar'da gönderilen fotoğraf, dosya ve sesli mesaj (src/features/chat/chatUpload.js); yalnız sohbetin üyeleri okur,
//   gönderen kendi klasörüne yükler; fotoğraf ve ses en çok 10 MB, dosya 20 MB. Silme: gönderen ya da ana hesap.
// avatars: profil fotoğrafları (src/features/people/ProfilePhoto.jsx); herkes kendisininkini, ana hesap herkesinkini yükler/siler, aynı kulüp okur.
service firebase.storage {
  match /b/{bucket}/o {
    function me() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function isOwner(orgId) {
      return request.auth != null && request.auth.uid == orgId
          && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) || me().get("role", "owner") != "staff");
    }
    function inOrg(orgId) {
      return isOwner(orgId) || (request.auth != null && me().get("orgId", "") == orgId);
    }

    match /orgs/{orgId}/fitMedia/{id} {
      allow read: if inOrg(orgId);
      allow delete: if isOwner(orgId);
      allow create, update: if isOwner(orgId)
                            && request.resource.size < 90 * 1024 * 1024
                            && request.resource.contentType.matches('(image|video)/.*');
    }

    match /orgs/{orgId}/raceFiles/{id} {
      allow read, delete: if isOwner(orgId);
      allow create, update: if isOwner(orgId)
                            && request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches('(image|application)/.*');
    }

    match /orgs/{orgId}/raceMedia/{id} {
      allow read, delete: if isOwner(orgId);
      allow create, update: if isOwner(orgId)
                            && request.resource.size < 60 * 1024 * 1024
                            && request.resource.contentType.matches('(image|video)/.*');
    }

    match /orgs/{orgId}/receiptImages/{by}/{name} {
      allow read, delete: if isOwner(orgId) || (inOrg(orgId) && request.auth.uid == by);
      allow create, update: if inOrg(orgId) && (isOwner(orgId) || request.auth.uid == by)
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    match /orgs/{orgId}/postPhotos/{name} {
      allow read, delete: if isOwner(orgId);
      allow create, update: if isOwner(orgId)
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    // Sohbet üyeliği (firestore.rules › chats ile aynı): sabit gruplarda türe göre, birebirde sohbet kimliğine göre, grupta members listesine göre
    function myKind() { return me().get("role", "owner") != "staff" ? "owner" : me().get("kind", "staff"); }
    function inChat(orgId, cid) {
      let uid = request.auth.uid;
      let path = /databases/(default)/documents/orgs/$(orgId)/chats/$(cid);
      return inOrg(orgId) && (
        isOwner(orgId) && cid in ["team", "family", "athletes"]
        || (cid == "team" && myKind() == "staff")
        || (cid == "family" && myKind() == "family")
        || (cid == "athletes" && myKind() in ["staff", "athlete", "student", "parent"])
        || (cid.matches("dm_.*") && cid.split("_").size() == 3 && uid in cid.split("_"))
        || (!(cid in ["team", "family", "athletes"]) && !cid.matches("dm_.*") && firestore.exists(path)
            && uid in firestore.get(path).data.get("members", [])));
    }

    match /orgs/{orgId}/chatFiles/{cid}/{by}/{name} {
      allow read: if inChat(orgId, cid);
      allow delete: if inOrg(orgId) && (request.auth.uid == by || isOwner(orgId));
      allow create: if inChat(orgId, cid) && request.auth.uid == by
                    && (request.resource.contentType.matches('(image|audio)/.*')
                          ? request.resource.size < 10 * 1024 * 1024
                          : request.resource.size < 20 * 1024 * 1024);
    }

    match /orgs/{orgId}/avatars/{who}/{name} {
      allow read: if inOrg(orgId);
      allow delete: if isOwner(orgId) || (inOrg(orgId) && request.auth.uid == who);
      allow create, update: if (isOwner(orgId) || (inOrg(orgId) && request.auth.uid == who))
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    match /orgs/{orgId}/{kind}/{id} {
      allow read, delete: if isOwner(orgId) && kind in ['invFiles', 'invoiceFiles', 'noticeFiles', 'mailFiles'];
      allow create, update: if isOwner(orgId) && kind in ['invFiles', 'invoiceFiles', 'noticeFiles', 'mailFiles']
                            && request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches('(image|application)/.*');
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
