# Bu dosyayı .env.local olarak kopyala ve doldur. .env.local git'e gönderilmez.
# Netlify'da aynı değişkenleri Site ayarları › Environment variables'a ekle.

# ---- Firebase (tarayıcıda da kullanılır) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Erişim ve güvenlik ----
# Yeni kayıt sayfası: 1 = açık, boş = kapalı (Firebase konsolunda da kaydı kapatman önerilir)
NEXT_PUBLIC_ALLOW_SIGNUP=
# Asistanı kullanabilecek e-postalar (virgülle). Boşsa giriş yapan herkes kullanır.
ALLOWED_EMAILS=
# Kişi başı yapay zeka istek sınırı (saatlik / günlük). Boşsa 120 / 600.
AI_LIMIT_HOUR=
AI_LIMIT_DAY=
# Yalnızca yerelde: 1 ise API'ler oturum sormaz (yayında etkisizdir, Netlify'a EKLEME)
DEV_SKIP_AUTH=

# ---- Yapay zeka (sunucu tarafı, tarayıcıya çıkmaz) ----
# gemini | anthropic (boşsa anahtarı olan kullanılır)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
# Kota dolunca sırayla denenecek modeller (virgülle)
GEMINI_FALLBACK_MODELS=
ANTHROPIC_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_VISION=

# ---- Ses ----
# Sesi yazıya çevirme: anahtarı olan servisler sırayla denenir (Groq → OpenAI → Gemini).
# STT_PROVIDER ile ilk denenecek seçilebilir: groq | openai | gemini
STT_PROVIDER=
# Groq (ücretsiz, hızlı Whisper): console.groq.com › API Keys
GROQ_API_KEY=
GROQ_STT_MODEL=
OPENAI_API_KEY=
STT_MODEL=
GEMINI_STT_MODEL=
# Tarayıcıda ses tanıma: auto | server | browser
NEXT_PUBLIC_STT_MODE=
# Seslendirme: device = yalnızca telefonun kendi sesi
TTS_ENGINE=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=

# ---- Plan hatırlatma bildirimleri ----
# npx web-push generate-vapid-keys ile üret
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İletişim adresi (bildirim servisleri için): mailto:senin@epostan.com
VAPID_SUBJECT=
# (isteğe bağlı) "iletildi" onayının imza anahtarı; boşsa VAPID_PRIVATE_KEY kullanılır
ACK_SECRET=
# Firebase hizmet hesabından iki alan (yalnızca Netlify'da; zamanlanmış görev planları okur)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Sporcular (kulübün diğer Firebase projesi: dikili-c7cc8) ----
# Ana sayfada "Sporcular" düğmesini görecek e-postalar (virgülle). Boşsa: seyhunyildiz@gmail.com
NEXT_PUBLIC_SPORCU_EMAILS=
