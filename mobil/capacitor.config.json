{
  "appId": "com.seyhunyildiz.sesliasistan",
  "appName": "Velora",
  "webDir": "www",
  "server": {
    "url": "https://sesliasistan.netlify.app",
    "androidScheme": "https",
    "errorPath": "index.html"
  },
  "android": {
    "backgroundColor": "#0b0b0c"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_asistan",
      "iconColor": "#22705c"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "ios": {
    "backgroundColor": "#0b0b0c",
    "appendUserAgent": "VeloraKaydir"
  }
}
